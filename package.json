{
  "name": "lark-docs-server",
  "version": "0.2.0",
  "private": true,
  "description": "本地服务：AI Agent 通过（模拟）Lark CLI 读取飞书/Lark 文档，支持多轮对话与 Markdown 渲染",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "demo": "LARK_CLI=./fixtures/lark-demo/lark node src/server.js",
    "lark": "node fixtures/lark-demo/lark",
    "test": "node --test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "marked": "^18.0.13",
    "typebox": "^1.3.7"
  }
}
